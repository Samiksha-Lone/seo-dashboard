{
  "name": "seo-dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "test": "node --test",
    "db:generate": "prisma generate",
    "db:seed-admin": "node --env-file=.env scripts/seed-admin.js",
    "worker": "node --env-file=.env src/workers/seo-audit.worker.js",
    "worker:dev": "node --watch --env-file=.env src/workers/seo-audit.worker.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@prisma/adapter-pg": "^6.19.0",
    "@prisma/client": "^6.19.0",
    "@supabase/supabase-js": "^2.118.0",
    "bullmq": "^6.5.3",
    "cheerio": "^1.2.0",
    "ioredis": "^6.0.0",
    "next": "14.2.35",
    "puppeteer": "^25.16.0",
    "react": "^18",
    "react-dom": "^18",
    "undici": "^7.30.1"
  },
  "devDependencies": {
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "postcss": "^8",
    "prisma": "^6.19.0",
    "tailwindcss": "^3.4.1"
  }
}
