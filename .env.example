# Required: PostgreSQL connection for Prisma, the dashboard, and the worker.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Required for login rate limiting, enqueueing, and audit processing. Use the Redis provider's TLS URL when required.
REDIS_URL="rediss://default:PASSWORD@YOUR_UPSTASH_HOST:6379"

# Login rate limiting is enforced through Redis; sign-in fails closed with HTTP 503 if Redis is unavailable.
LOGIN_RATE_LIMIT_MAX_ATTEMPTS="5"
LOGIN_RATE_LIMIT_WINDOW_SECONDS="900"
# Optional trusted ingress header containing exactly one client IP (for example x-real-ip).
# The proxy must overwrite this header and the application origin must not be directly reachable.
TRUSTED_PROXY_IP_HEADER=""

# Keep true for local development. PageSpeed, GSC, and DataForSEO remain mocked either way.
# Set to false to use the Claude API (ANTHROPIC_API_KEY is then required).
USE_MOCKS="true"

# Required only when USE_MOCKS=false. Never needed in mock mode.
ANTHROPIC_API_KEY="your-anthropic-api-key"

# Optional absolute local-development storage path; empty uses .local-reports in the project directory.
REPORT_STORAGE_DIR=""

# Required in production for report uploads and authorized PDF downloads.
# Use the Supabase sb_secret_ key. Keep it server-side; never use a NEXT_PUBLIC_ variable.
SUPABASE_URL=""
SUPABASE_SECRET_KEY=""

# Required only if using POST /api/cron/monthly-audits; replace with a strong random secret.
CRON_SECRET="replace-with-a-long-random-secret"

# Required only for the one-time initial administrator setup. Remove from .env after provisioning.
INITIAL_ADMIN_EMAIL="admin@example.com"
INITIAL_ADMIN_PASSWORD="replace-with-a-unique-password-of-at-least-12-characters"
# Optional display name for the initial administrator.
INITIAL_ADMIN_NAME="Administrator"
