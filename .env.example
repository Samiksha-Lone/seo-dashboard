# Required: PostgreSQL connection for Prisma, the dashboard, and the worker.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Required to enqueue and process audits. Use the Redis provider's TLS URL when required.
REDIS_URL="rediss://default:PASSWORD@YOUR_UPSTASH_HOST:6379"

# Recommended for local development; mock Claude and SEO provider signals.
# Set to false to use the Claude API (ANTHROPIC_API_KEY is then required).
USE_MOCKS="true"

# Required only when USE_MOCKS=false. Never needed in mock mode.
ANTHROPIC_API_KEY="your-anthropic-api-key"

# Optional absolute path shared by web and worker. Empty uses .local-reports in the project directory.
REPORT_STORAGE_DIR=""

# Required only if using POST /api/cron/monthly-audits; replace with a strong random secret.
CRON_SECRET="replace-with-a-long-random-secret"
